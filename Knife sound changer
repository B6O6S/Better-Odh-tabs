-- ODH Plugin: Combined Modules (Optimized)
if not odh_shared_plugins then
    warn("ODH Shared Plugins environment not found! Load the main hub first.")
    return
end

local shared = odh_shared_plugins
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- 1. Knife Sound Changer (Optimized - No Heartbeat Loop)
--------------------------------------------------------------------------------
do
    local knifeSoundSection = shared.AddSection("Knife Sound Changer")  

    local sounds = {  
        "Default|142247768",  
        "Tom scream|133946057163378",  
        "Cat laugh|136958794247658",  
        "miskeen (B6O6S)|71767902510649",
        "يلعن ابو لعبك (3RQ)|89850487492275",  
        "FAH|137533276939300",
        "Arabic kid|84433159756169",
        "Custom|0"  
    }  

    -- Use getgenv() to save the choice across script re-executions
    getgenv().KnifeSound_SavedId = getgenv().KnifeSound_SavedId or "rbxassetid://142247768"
    getgenv().KnifeSound_SavedName = getgenv().KnifeSound_SavedName or "Default"
    getgenv().KnifeSound_CustomId = getgenv().KnifeSound_CustomId or nil
    getgenv().KnifeSound_Enabled = getgenv().KnifeSound_Enabled or false
    getgenv().KnifeSound_Volume = getgenv().KnifeSound_Volume or 1
    getgenv().KnifeSound_PlayAllFE = getgenv().KnifeSound_PlayAllFE or false

    local selectedSoundId = getgenv().KnifeSound_SavedId
    local customEnabled = getgenv().KnifeSound_Enabled  
    local customTextboxId = getgenv().KnifeSound_CustomId  
    local lastSelected = getgenv().KnifeSound_SavedName  
    local soundVolume = getgenv().KnifeSound_Volume
    local playAllFEEnabled = getgenv().KnifeSound_PlayAllFE
    
    local connections = {}  
    local processedKnifeSounds = {}

    -- Function to play sound (used for testing)
    local function playSound(soundId, volume)
        if not soundId or soundId == "" then return end
        local soundObj = Instance.new("Sound")
        soundObj.SoundId = soundId
        soundObj.Volume = volume or 1
        soundObj.PlayOnRemove = true
        soundObj.Parent = workspace
        soundObj:Destroy()
    end

    local function layerSound(origSound)  
        if not customEnabled or not selectedSoundId then return end  
        origSound.Volume = 0  

        if connections[origSound] then  
            connections[origSound]:Disconnect()  
        end  

        connections[origSound] = origSound.Played:Connect(function()  
            if not customEnabled then return end
            local pureId = string.match(selectedSoundId, "(%d+)") or "142247768"
            local assetUrl = "https://www.roblox.com/asset/?id=" .. pureId
            
            local playSongRemote = ReplicatedStorage:FindFirstChild("Remotes") 
                and ReplicatedStorage.Remotes:FindFirstChild("Inventory") 
                and ReplicatedStorage.Remotes.Inventory:FindFirstChild("PlaySong")

            local effectiveVolume = soundVolume
            if playAllFEEnabled and playSongRemote then
                pcall(function()
                    playSongRemote:FireServer(assetUrl)
                end)
                effectiveVolume = 0
            end

            local custom = Instance.new("Sound")  
            custom.SoundId = selectedSoundId  
            custom.Volume = effectiveVolume  
            custom.PlayOnRemove = true  
            custom.Parent = origSound.Parent  
            custom:Play()  

            custom.Ended:Connect(function()
                if playAllFEEnabled and playSongRemote then
                    pcall(function()
                        playSongRemote:FireServer("https://www.roblox.com/asset/?id=0")
                    end)
                end
            end)

            task.spawn(function()
                local startTime = tick()
                while custom.TimeLength == 0 and tick() - startTime < 2 do
                    task.wait(0.05)
                end
                local length = custom.TimeLength
                if not length or length == 0 then
                    length = 0.5
                end
                task.wait(length)
                if playAllFEEnabled and playSongRemote then
                    pcall(function()
                        playSongRemote:FireServer("https://www.roblox.com/asset/?id=0")
                    end)
                end
            end)
        end)  
    end  

    -- Setup listener for new sound instances instead of running :GetDescendants() every frame on Heartbeat
    local function setupKnifeSoundInstance(obj)
        if obj:IsA("Sound") and not processedKnifeSounds[obj] then
            processedKnifeSounds[obj] = true
            
            if obj.Name == "Kill" then
                layerSound(obj)
            end

            -- Clean up cache when sound is destroyed
            obj.Destroying:Connect(function()
                processedKnifeSounds[obj] = nil
                if connections[obj] then
                    connections[obj]:Disconnect()
                    connections[obj] = nil
                end
            end)
        end
    end

    local function hookContainer(container)
        if not container then return end
        for _, obj in ipairs(container:GetDescendants()) do
            setupKnifeSoundInstance(obj)
        end
        container.DescendantAdded:Connect(setupKnifeSoundInstance)
    end

    if LocalPlayer.Backpack then
        hookContainer(LocalPlayer.Backpack)
    end
    LocalPlayer.Backpack.ChildAdded:Connect(function(tool)
        task.spawn(function()
            tool:WaitForChild("Handle", 2)
            hookContainer(tool)
        end)
    end)

    LocalPlayer.CharacterAdded:Connect(function(char)
        task.spawn(function()
            char:WaitForChild("HumanoidRootPart", 5)
            hookContainer(char)
        end)
    end)

    if LocalPlayer.Character then
        hookContainer(LocalPlayer.Character)
    end

    local function refreshKnifeSounds()
        local containers = {LocalPlayer.Backpack, LocalPlayer.Character}  
        for _, container in ipairs(containers) do  
            if container then  
                for _, obj in ipairs(container:GetDescendants()) do  
                    if obj:IsA("Sound") and obj.Name == "Kill" then  
                        layerSound(obj)  
                    end  
                end  
            end  
        end  
    end

    knifeSoundSection:AddToggle("Custom Knife Sound [ Client Sided ]", function(bool)  
        customEnabled = bool  
        getgenv().KnifeSound_Enabled = bool  
        if bool then refreshKnifeSounds() end  
    end)  

    knifeSoundSection:AddToggle("Play For all [ FE ]", function(bool)
        playAllFEEnabled = bool
        getgenv().KnifeSound_PlayAllFE = bool
    end)

    knifeSoundSection:AddTextBox("Custom SoundId", function(text)  
        if text and text ~= "" then  
            if not string.find(text, "rbxassetid://") then  
                customTextboxId = "rbxassetid://" .. text  
            else  
                customTextboxId = text  
            end  

            getgenv().KnifeSound_CustomId = customTextboxId  

            if lastSelected == "Custom" then  
                selectedSoundId = customTextboxId  
                getgenv().KnifeSound_SavedId = selectedSoundId  
                refreshKnifeSounds()  
            end  
        end  
    end)  

    local dropdownOptions = {}  
    for _, data in ipairs(sounds) do  
        local name = string.match(data, "(.-)|%d+")  
        table.insert(dropdownOptions, name)  
    end  

    local dropdown = knifeSoundSection:AddDropdown("Select Sound", dropdownOptions, function(selected)  
        lastSelected = selected  
        getgenv().KnifeSound_SavedName = selected  

        if selected == "Custom" then  
            selectedSoundId = customTextboxId  
        else  
            for _, data in ipairs(sounds) do  
                local name, id = string.match(data, "(.-)|(%d+)")  
                if name == selected then  
                    selectedSoundId = "rbxassetid://" .. id  
                    break  
                end  
            end  
        end  

        getgenv().KnifeSound_SavedId = selectedSoundId  
        refreshKnifeSounds()  
    end)  

    pcall(function() 
        if dropdown and dropdown.Select then
            dropdown.Select(getgenv().KnifeSound_SavedName) 
        end
    end)

    -- Volume Slider
    pcall(function()
        knifeSoundSection:AddSlider("Volume", 0, 10, soundVolume * dt or soundVolume * 10, function(value)
            soundVolume = value / 10
            getgenv().KnifeSound_Volume = soundVolume
        end)
    end)

    -- Test Sound Effect Button
    knifeSoundSection:AddButton("Test Sound Effect", function()
        playSound(selectedSoundId, soundVolume)
    end)
end
