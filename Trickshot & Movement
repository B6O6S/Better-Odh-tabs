local function getBombToolName()
    return selectedBombType == "Gold Bomb" and "GoldBomb" or "FakeBomb"
end

local function executeBombJumpAction(isToggleMode)
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end

	hasTriggered = true
	isActive = false
	
	task.spawn(function()
		if isToggleMode then
			task.wait(0.1)
		end

		local toolName = getBombToolName()
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		local tool = character:FindFirstChild(toolName) or (backpack and backpack:FindFirstChild(toolName))
		
		if tool then
			if tool.Parent == backpack then
				humanoid:EquipTool(tool)
			end
			
			toyEvent:InvokeServer(toolName)
			
			local VirtualUser = game:GetService("VirtualUser")
			VirtualUser:Button1Down(Vector2.new(0, 0))
			VirtualUser:Button1Up(Vector2.new(0, 0))
			
			if tool.Parent == character then
				tool.Parent = backpack
			end
		end
		
		if isToggleMode then
			task.wait(0.1)
		end

		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		humanoid.Jump = true
		
		isWaitingTimer = true
		stroke.Color = Color3.fromRGB(255, 0, 0)
		local currentToken = timerToken
		local waitTime = selectedBombType == "Gold Bomb" and 3.2 or 21.7
		local startTime = tick()
		
		while true do
			if timerToken ~= currentToken then return end
			local elapsed = tick() - startTime
			local remaining = waitTime - elapsed
			
			if remaining <= 0 then break end
			
			button.Text = string.format("Wait (%.1fs)", remaining)
			button.TextColor3 = Color3.fromRGB(255, 0, 0)
			task.wait(0.05)
		end
		
		if timerToken ~= currentToken then return end
		isWaitingTimer = false
		hasTriggered = false
		
		if bombUseMode == "Toggle To Use Bomb" then
			button.Text = "Bomb Jump (OFF)"
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			button.Text = "Bomb Jump"
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end)
end

button.MouseButton1Click:Connect(function()
	if moved or isWaitingTimer then return end
	local toolName = getBombToolName()
	
	if bombUseMode == "Toggle To Use Bomb" then
		isActive = not isActive
		if isActive then
			button.Text = "Ready"
			button.TextColor3 = Color3.fromRGB(50, 255, 50)
			stroke.Color = Color3.fromRGB(50, 200, 50)
			hasTriggered = false
			toyEvent:InvokeServer(toolName)
		else
			button.Text = "Bomb Jump (OFF)"
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
			stroke.Color = Color3.fromRGB(255, 255, 255)
			hasTriggered = false
		end
	elseif bombUseMode == "Click To Use Bomb" then
		toyEvent:InvokeServer(toolName)
		executeBombJumpAction(false)
	end
end)

local function setupCharacterBomb(character)
	local humanoid = character:WaitForChild("Humanoid")
	
	timerToken = timerToken + 1
	isWaitingTimer = false
	hasTriggered = false
	
	if bombUseMode == "Toggle To Use Bomb" then
		if not isActive then
			button.Text = "Bomb Jump (OFF)"
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
			stroke.Color = Color3.fromRGB(255, 255, 255)
		end
	else
		button.Text = "Bomb Jump"
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end

	humanoid.StateChanged:Connect(function(oldState, newState)
		if bombUseMode ~= "Toggle To Use Bomb" or not isActive or hasTriggered or isWaitingTimer then return end
		
		if newState == Enum.HumanoidStateType.Jumping then
			executeBombJumpAction(true)
		elseif newState == Enum.HumanoidStateType.Landed then
			if not isWaitingTimer then
				hasTriggered = false
			end
		end
	end)
end

