-- =============================
-- TOY AUTO-SPAWN
-- =============================

local autoSpawnToysEnabled = false
local selectedToy1 = "None"
local selectedToy2 = "None"
local availableToysList = {
	"None"
}

local function getToysFolder()

	local backpack =
		LocalPlayer:WaitForChild(
			"Backpack",
			5
		)

	if backpack then

		return backpack:WaitForChild(
			"Toys",
			5
		)
	end

	return nil
end

local function updateAvailableToys()

	local toysFolder =
		getToysFolder()

	local list = {
		"None"
	}

	if toysFolder then

		for _, toy in ipairs(
			toysFolder:GetChildren()
		) do

			table.insert(
				list,
				toy.Name
			)
		end
	end

	availableToysList =
		list
end

updateAvailableToys()

local function spawnSelectedToys()

	if not autoSpawnToysEnabled then
		return
	end

	task.spawn(function()

		local character =
			LocalPlayer.Character
			or LocalPlayer.CharacterAdded:Wait()

		character:WaitForChild(
			"Humanoid",
			5
		)

		getToysFolder()

		task.wait(0.5)

		if selectedToy1
			and selectedToy1 ~= "None" then

			pcall(function()

				toyEvent:InvokeServer(
					selectedToy1
				)

			end)

			task.wait(0.3)
		end

		if selectedToy2
			and selectedToy2 ~= "None" then

			pcall(function()

				toyEvent:InvokeServer(
					selectedToy2
				)

			end)
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(function()

	spawnSelectedToys()

end)

trickTab:AddToggle(
	"Auto Spawn Toys On Respawn",
	function(on)

		autoSpawnToysEnabled =
			on

		if on then
			spawnSelectedToys()
		end
	end
)

trickTab:AddDropdown(
	"Select Toy Slot 1",
	availableToysList,
	function(selected)

		selectedToy1 =
			selected
	end
)

trickTab:AddDropdown(
	"Select Toy Slot 2",
	availableToysList,
	function(selected)

		selectedToy2 =
			selected
	end
)
