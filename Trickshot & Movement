			255,
			0,
			0
		)

	local function setReloadingVisuals()

		flickButton.TextColor3 =
			reloadColor

		if flickStroke then

			flickStroke.Color =
				reloadColor
		end
	end

	local function setNormalVisuals()

		flickButton.TextColor3 =
			normalTextColor

		if flickStroke then

			flickStroke.Color =
				normalStrokeColor
		end
	end

	local function startReload()

		flickReloading = true

		setReloadingVisuals()

		local endTime =
			os.clock()
			+ FLICK_RELOAD_TIME

		while true do

			local remaining =
				endTime
				- os.clock()

			if remaining <= 0 then
				break
			end

			flickButton.Text =
				"Reloading... "
				.. string.format(
					"%.1f",
					remaining
				)

			task.wait(0.05)
		end

		flickReloading = false

		flickButton.Text =
			"Flick Shoot"

		setNormalVisuals()
	end

	-- =============================
	-- FRIEND CHECK
	-- =============================

	local function isFriend(player)

		if not player then
			return false
		end

		local success, result =
			pcall(function()

				return LocalPlayer:IsFriendsWith(
					player.UserId
				)

			end)

		return success
			and result == true
	end

	-- =============================
	-- FIND MURDERER
	-- =============================

	local function findMurderer()

		local players =
			Players:GetPlayers()

		-- First: Role
		for _, player in ipairs(players) do

			if player ~= LocalPlayer then

				local success, role =
					pcall(function()

						return player.Role

					end)

				if success
					and role == "Murderer" then

					if hasLineOfSight(
						player.Character
					) then

						return player
					end
				end
			end
		end

		-- Second: Knife
		for _, player in ipairs(players) do

			if player ~= LocalPlayer then

				local character =
					player.Character

				local isMurderer =
					false

				if character
					and character:FindFirstChild(
						"Knife"
					) then

					isMurderer = true
				end

				local backpack =
					player:FindFirstChild(
						"Backpack"
					)

				if backpack
					and backpack:FindFirstChild(
						"Knife"
					) then

					isMurderer = true
				end

				if isMurderer then

					if hasLineOfSight(
						character
					) then

						return player
					end
				end
			end
		end

		return nil
	end

	-- =============================
	-- SMOOTH DURATION
	-- =============================

	local function getSmoothDuration()

		local minimumDuration =
			0.035

		local maximumDuration =
			0.35

		local alpha =
			(
				flickSmoothSpeed - 1
			) / 19

		return maximumDuration
			- (
				(
					maximumDuration
					- minimumDuration
				)
				* alpha
			)
	end

	-- =============================
	-- SMOOTH ROTATION
	-- =============================

	local function smoothFlick(
		hrp,
		humanoid,
		targetPosition,
		camera,
		useCamera
	)

		if not hrp
			or not humanoid then

			return
		end

		if not hrp.Parent
			or not humanoid.Parent then

			return
		end

		local startPosition =
			hrp.Position

		local flatTarget =
			Vector3.new(
				targetPosition.X,
				startPosition.Y,
				targetPosition.Z
			)

		local direction =
			flatTarget - startPosition

		if direction.Magnitude <= 0.01 then
			return
		end

		direction =
			direction.Unit

		-- Character target
		local targetCharacterCFrame =
			CFrame.lookAt(
				startPosition,
				startPosition + direction
			)

		local startCharacterCFrame =
			hrp.CFrame

		-- Camera target
		local startCameraCFrame = nil
		local targetCameraCFrame = nil

		if camera and useCamera then

			startCameraCFrame =
				camera.CFrame

			local cameraPosition =
				camera.CFrame.Position

			targetCameraCFrame =
				CFrame.lookAt(
					cameraPosition,
					targetPosition
				)
		end

		-- Prevent Roblox AutoRotate
		-- from fighting our rotation.
		local oldAutoRotate =
			humanoid.AutoRotate

		humanoid.AutoRotate =
			false

		local duration =
			getSmoothDuration()

		local startTime =
			os.clock()

		-- Unique render-step name
		local renderName =
			"FlickSmoothRotation_"
			.. tostring(
				math.random(
					100000,
					999999
				)
			)

		local finished = false

		local function update()

			if finished then
				return
			end

			if not hrp.Parent then

				finished = true
				return
			end

			local elapsed =
				os.clock()
				- startTime

			local alpha =
				math.clamp(
					elapsed / duration,
					0,
					1
				)

			-- Smoothstep
			local eased =
				alpha
				* alpha
				* (3 - 2 * alpha)

			-- Keep the player's CURRENT
			-- position. Never teleport.
			local currentPosition =
				hrp.Position

			local desiredCFrame =
				CFrame.lookAt(
					currentPosition,
					currentPosition
					+ direction
				)

			local newCFrame =
				startCharacterCFrame:Lerp(
					desiredCFrame,
					eased
				)

			-- Only use rotation from
			-- the calculated CFrame.
			hrp.CFrame =
				CFrame.new(
					currentPosition
				)
				* CFrame.fromMatrix(
					Vector3.zero,
					newCFrame.RightVector,
					newCFrame.UpVector
				)

			-- Camera is updated AFTER
			-- Roblox's camera update.
			if camera
				and useCamera
				and targetCameraCFrame
				and startCameraCFrame then

				camera.CFrame =
					startCameraCFrame:Lerp(
						targetCameraCFrame,
						eased
					)
			end

			if alpha >= 1 then

				finished = true
			end
		end

		-- Run after Roblox Camera
		-- controller.
		pcall(function()

			RunService:BindToRenderStep(
				renderName,
				Enum.RenderPriority.Camera.Value + 1,
				update
			)

		end)

		-- Wait until rotation finishes.
		while not finished do

			if not hrp.Parent
				or not humanoid.Parent then

				finished = true
				break
			end

			RunService.Heartbeat:Wait()
		end

		pcall(function()

			RunService:UnbindFromRenderStep(
				renderName
			)

		end)

		-- Final character rotation
		if hrp.Parent then

			local finalPosition =
				hrp.Position

			hrp.CFrame =
				CFrame.lookAt(
					finalPosition,
					finalPosition
					+ direction
				)
		end

		-- Final camera rotation
		if camera
			and useCamera
			and targetCameraCFrame then

			camera.CFrame =
				targetCameraCFrame
		end

		-- Restore AutoRotate
		humanoid.AutoRotate =
			oldAutoRotate
	end

	-- =============================
	-- FLICK SHOOT
	-- =============================

	local function executeFlickShoot()

		if flickReloading then
			return
		end

		local character =
			LocalPlayer.Character

		if not character then
			return
		end

		local humanoid =
			character:FindFirstChildOfClass(
				"Humanoid"
			)

		local hrp =
			character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not humanoid
			or not hrp then

			return
		end

		local targetPlayer =
			findMurderer()

		if not targetPlayer
			or not targetPlayer.Character then

			if flickWallCheckEnabled then

				flickButton.Text =
					"No Clear Target"

			else

				flickButton.Text =
					"No Murderer Found"

			end

			task.wait(1)

			if not flickReloading then

				flickButton.Text =
					"Flick Shoot"

			end

			return
		end

		-- =============================
		-- WHITELIST FRIENDS
		-- =============================

		if whitelistFriendsEnabled
			and isFriend(targetPlayer) then

			flickButton.Text =
				"Friend Is Murderer"

			task.wait(1)

			if not flickReloading then

				flickButton.Text =
					"Flick Shoot"

			end

			return
		end

		local targetHrp =
			targetPlayer.Character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not targetHrp then
			return
		end

		-- =============================
		-- FIND GUN
		-- =============================

		local backpack =
			LocalPlayer:FindFirstChild(
				"Backpack"
			)

		local gunTool =
			character:FindFirstChild(
				"Gun"
			)
			or (
				backpack
				and backpack:FindFirstChild(
					"Gun"
				)
			)

		if not gunTool then

			flickButton.Text =
				"No Gun Found"

			task.wait(1)

			if not flickReloading then

				flickButton.Text =
					"Flick Shoot"

			end

			return
		end

		if gunTool.Parent ==
			backpack then

			humanoid:EquipTool(
				gunTool
			)

			task.wait()
		end


		-- =============================
		-- SAVE ORIGINAL ROTATION
		-- =============================

		local originalLookVector =
			hrp.CFrame.LookVector

		local camera =
			workspace.CurrentCamera

		local useCamera =
			shouldSnapCamera()

		local originalCameraCFrame =
			nil

		if camera and useCamera then

			originalCameraCFrame =
				camera.CFrame
		end

		-- =============================
		-- TARGET DIRECTION
		-- =============================

		local currentPosition =
			hrp.Position

		local targetPosition =
			Vector3.new(
				targetHrp.Position.X,
				currentPosition.Y,
				targetHrp.Position.Z
			)

		local direction =
			targetPosition
			- currentPosition

		if direction.Magnitude <= 0.01 then
			return
		end

		direction =
			direction.Unit

		-- =============================
		-- ROTATE
		-- =============================

		if flickMode == "Smooth" then

			smoothFlick(
				hrp,
				humanoid,
				targetHrp.Position,
				camera,
				useCamera
			)

		else

			-- Instant player rotation
			hrp.CFrame =
				CFrame.lookAt(
					currentPosition,
					currentPosition
					+ direction
				)

			-- Instant camera snap
			if camera and useCamera then

				local cameraPosition =
					camera.CFrame.Position

				camera.CFrame =
					CFrame.lookAt(
						cameraPosition,
						targetHrp.Position
					)
			end
		end

		-- =============================
		-- SHOOT
		-- =============================

		gunTool:Activate()

		local VirtualUser =
			game:GetService(
				"VirtualUser"
			)

		VirtualUser:Button1Down(
			Vector2.new(0, 0)
		)

		VirtualUser:Button1Up(
			Vector2.new(0, 0)
		)

		task.wait(0.15)

		-- =============================
		-- RESTORE CHARACTER ROTATION
		-- =============================

		local restorePosition =
			hrp.Position

		local flatLook =
			Vector3.new(
				originalLookVector.X,
				0,
				originalLookVector.Z
			)

		if flatLook.Magnitude > 0.01 then

			flatLook =
				flatLook.Unit

			hrp.CFrame =
				CFrame.lookAt(
					restorePosition,
					restorePosition
					+ flatLook
				)
		end

		-- =============================
		-- RESTORE CAMERA
		-- =============================

		if camera
			and originalCameraCFrame
			and useCamera then

			camera.CFrame =
				originalCameraCFrame
		end

		-- =============================
		-- UNEQUIP GUN
		-- =============================

		if gunTool.Parent ==
			character then

			gunTool.Parent =
				backpack
		end

		-- =============================
		-- START RELOAD
		-- =============================

		task.spawn(
			startReload
		)
	end

