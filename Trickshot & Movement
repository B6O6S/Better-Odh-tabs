-- =============================
RunService.RenderStepped:Connect(function(delta)
    local char = LocalPlayer.Character
    if not char then return end
    local HRP = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not HRP or not humanoid then return end

    if strafeEnabled then
        local moveVec = HRP.CFrame.RightVector * strafeDirection
        HRP.CFrame = HRP.CFrame + moveVec.Unit * strafeSpeed * delta
        if tick() % 1 < 0.5 then
            strafeDirection = 1
        else
            strafeDirection = -1
        end
    end

    if trickshotEnabled then
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
            spinning = true
        elseif spinning and humanoid:GetState() == Enum.HumanoidStateType.Landed then
            spinning = false
        end

        if spinning then
            HRP.CFrame = HRP.CFrame * CFrame.Angles(0, spinSpeed, 0)
        end
    end
end)

-- =============================
-- WALLHOP FEATURE
-- =============================
local wallhopEnabled = false
local backToNormalEnabled = false
local selectedLookDirection = "Back"
local InfiniteJumpEnabled = true
local wallRaycastParams = RaycastParams.new()
wallRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist

local function performWallhop()
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or humanoid:GetState() == Enum.HumanoidStateType.Dead then return end

    wallRaycastParams.FilterDescendantsInstances = {character}
    local raycastResult = Workspace:Raycast(hrp.Position, hrp.CFrame.LookVector * 3, wallRaycastParams)

    if raycastResult then
        InfiniteJumpEnabled = false
        humanoid:ChangeState("Jumping")
        
        if backToNormalEnabled then
            if selectedLookDirection == "Back" then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.pi, 0)
            elseif selectedLookDirection == "Right" then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, -math.pi/2, 0)
            elseif selectedLookDirection == "Left" then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.pi/2, 0)
            end

            task.wait(0.15)
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, (selectedLookDirection == "Back" and math.pi or (selectedLookDirection == "Right" and math.pi/2 or -math.pi/2)), 0)
        else
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, -1, 0)
            task.wait(0.1)
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, 1, 0)
        end

        task.wait(0.1)
        InfiniteJumpEnabled = true
    end
end

trickTab:AddToggle("Enable Wallhop", function(on)
    wallhopEnabled = on
end)

trickTab:AddToggle("Back To Normal position after jump", function(on)
    backToNormalEnabled = on
end)

trickTab:AddDropdown("Wallhop Look Direction", {"Back", "Right", "Left"}, function(selected)
    selectedLookDirection = selected
end)

trickTab:AddKeybind("Wallhop Jump Key", "J", performWallhop)

UserInputService.JumpRequest:Connect(function()
    if wallhopEnabled and InfiniteJumpEnabled then
        performWallhop()
    end
end)

